# ============ 必填（在 GitHub → Settings → Secrets and variables → Actions 配置）============

# 境内工商数据：CNBizAPI（注册后控制台获取，形如 cbz_xxxx）
# 免费额度 200 次/月；get_shareholders 每次消耗 1 积分
CNBIZAPI_KEY=
CNBIZAPI_BASE_URL=https://api.cnbizapi.com

# LLM：任意 OpenAI 兼容接口（DeepSeek / GLM / Qwen 均可）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 图数据库：GitHub Actions 使用 Neo4j Service Container
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ============ 阶段二（美股 20-F）预留，先填占位值即可 ============
# SEC EDGAR 要求 User-Agent 携带应用名与联系邮箱
SEC_IDENTITY=redchip-penetration you@example.com

# ============ 可选 ============
# 离岸注册处验证（OpenRegistry MCP，免费无需 Key）
OPENREGISTRY_MCP_URL=https://openregistry.sophymarine.com/mcp

# 本地离线联调：true 时不发起任何外部请求，全部走 fixtures/
REDCHIP_MOCK=false
# 输出根目录
REDCHIP_OUTPUT_DIR=output
